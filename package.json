{
  "name": "typehero",
  "private": true,
  "version": "1.0.0",
  "description": "TypeHero 打字小英雄：本地保存进度的教材打字练习游戏",
  "author": "TypeHero",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "cd server && npm run dev",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "desktop:dev": "npm run build:desktop && electron .",
    "desktop:pack": "npm run build:desktop && electron-builder --win portable --x64",
    "desktop:test": "npm run build:desktop && node tests/desktop/smoke.cjs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "framer-motion": "^12.18.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.7.1",
    "sql.js": "^1.15.1",
    "uuid": "^11.1.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.1.11",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
